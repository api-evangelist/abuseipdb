        {
          "id": "925f6be2-0114-4043-bd2a-b5732c34db0c",
          "name": "Check an IP Address",
          "request": {
            "name": "Check an IP Address",
            "description": {
              "content": "Returns the current abuse data for a single IPv4 or IPv6 address,\nincluding the abuse confidence score, country, ISP, usage type, and\n(when `verbose` is set) the most recent reports.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "check"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ipAddress",
                  "value": "<ip>",
                  "description": "(Required) The IPv4 or IPv6 address to check."
                },
                {
                  "disabled": false,
                  "key": "maxAgeInDays",
                  "value": "30",
                  "description": "Restrict reports considered to those within the last N days (1-365, default 30)."
                },
                {
                  "disabled": false,
                  "key": "verbose",
                  "value": "<boolean>",
                  "description": "When present, include the most recent reports in the response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
