      "name": "Blacklist",
      "description": {
        "content": "Endpoints for downloading the community blacklist.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3e2b2a2d-a778-4010-a4aa-8856417ddcbb",
          "name": "Download the AbuseIPDB Blacklist",
          "request": {
            "name": "Download the AbuseIPDB Blacklist",
            "description": {
              "content": "Returns the AbuseIPDB blacklist. Free accounts receive up to 10,000\nentries; subscriber tiers can customise the confidence floor, country\nfilters, IP version, and maximum result count.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "blacklist"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "confidenceMinimum",
                  "value": "100",
                  "description": "Minimum confidence score (25-100, default 100; subscriber feature below 100)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of entries to return (varies by plan, up to 500,000)."
                },
                {
                  "disabled": false,
                  "key": "onlyCountries",
                  "value": "<string>",
                  "description": "Comma-separated ISO 3166-1 alpha-2 country codes to include (subscriber feature)."
                },
                {
                  "disabled": false,
                  "key": "exceptCountries",
                  "value": "<string>",
                  "description": "Comma-separated ISO 3166-1 alpha-2 country codes to exclude (subscriber feature)."
                },
                {
                  "disabled": false,
                  "key": "ipVersion",
                  "value": "<integer>",
                  "description": "Restrict to a specific IP version (4 or 6)."
                },
                {
                  "disabled": false,
                  "key": "plaintext",
                  "value": "<boolean>",
                  "description": "When present, return one IP per line as text/plain instead of JSON."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
